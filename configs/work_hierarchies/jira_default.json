{
  "id": "WORK-HIERARCHY-JIRA-DEFAULT",
  "name": "Jira Default Hierarchy",
  "platform": "jira",
  "description": "Default Jira-style hierarchy with initiative, epic, story, task, and sub-task support. This should be edited per Jira site because Advanced Roadmaps and issue type schemes vary by organization.",
  "levels": [
    {
      "key": "initiative",
      "label": "Initiative",
      "order": 1,
      "enabled": true,
      "maps_to": "Initiative",
      "description": "Portfolio-level body of work. May require Advanced Roadmaps or custom issue type.",
      "required_fields": ["summary", "description", "owner_role"],
      "optional_fields": ["target_start", "target_end", "business_value", "risk_rating"],
      "can_have_children": true,
      "can_be_exported": true
    },
    {
      "key": "epic",
      "label": "Epic",
      "order": 2,
      "enabled": true,
      "maps_to": "Epic",
      "description": "Large deliverable or capability grouping.",
      "required_fields": ["summary", "description", "owner_role"],
      "optional_fields": ["epic_name", "target_start", "target_end", "risk_rating"],
      "can_have_children": true,
      "can_be_exported": true
    },
    {
      "key": "story",
      "label": "Story",
      "order": 3,
      "enabled": true,
      "maps_to": "Story",
      "description": "User-facing or team-executable deliverable.",
      "required_fields": ["summary", "description", "acceptance_criteria"],
      "optional_fields": ["owner_role", "evidence_required", "risk_rating"],
      "can_have_children": true,
      "can_be_exported": true
    },
    {
      "key": "task",
      "label": "Task",
      "order": 4,
      "enabled": true,
      "maps_to": "Task",
      "description": "Implementation, QA, review, or operational work item.",
      "required_fields": ["summary", "description"],
      "optional_fields": ["owner_role", "evidence_required", "risk_rating"],
      "can_have_children": true,
      "can_be_exported": true
    },
    {
      "key": "subtask",
      "label": "Sub-task",
      "order": 5,
      "enabled": true,
      "maps_to": "Sub-task",
      "description": "Lowest-level work item. Some Jira projects disable sub-tasks.",
      "required_fields": ["summary", "description"],
      "optional_fields": ["owner_role", "estimate", "dependency_type"],
      "can_have_children": false,
      "can_be_exported": true
    }
  ],
  "allowed_relationships": [
    {"parent": "initiative", "child": "epic", "enabled": true},
    {"parent": "epic", "child": "story", "enabled": true},
    {"parent": "epic", "child": "task", "enabled": true},
    {"parent": "story", "child": "subtask", "enabled": true},
    {"parent": "task", "child": "subtask", "enabled": true}
  ],
  "dependency_types": [
    {"key": "blocks", "label": "Blocks", "direction": "outgoing", "description": "This item blocks another item.", "blocks_schedule": true},
    {"key": "blocked_by", "label": "Blocked By", "direction": "incoming", "description": "This item cannot start or finish until another item is complete.", "blocks_schedule": true},
    {"key": "relates_to", "label": "Relates To", "direction": "bidirectional", "description": "Related work but not schedule-blocking.", "blocks_schedule": false},
    {"key": "must_finish_before", "label": "Must Finish Before", "direction": "outgoing", "description": "Finish-to-start dependency for Gantt planning.", "blocks_schedule": true}
  ],
  "export_behavior": {
    "flatten_unsupported_levels": true,
    "unsupported_level_strategy": "flatten_to_story",
    "preserve_original_hierarchy_fields": true,
    "include_dependency_columns": true,
    "include_gantt_columns": true
  }
}
